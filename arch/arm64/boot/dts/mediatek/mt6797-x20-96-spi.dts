/* Established native baseline plus the external STM32 SPI test peer. */
/dts-v1/;

#include "mt6797-x20-96-i2c.dts"

/ {
	spi0: spi@1100a000 {
		compatible = "mediatek,mt6797-spi";
		reg = <0 0x1100a000 0 0x1000>;
		interrupts = <GIC_SPI 122 IRQ_TYPE_LEVEL_LOW>;
		clocks = <&topckgen CLK_TOP_SYSPLL3_D2>,
			 <&topckgen CLK_TOP_MUX_SPI>, <&infrasys CLK_INFRA_SPI>;
		clock-names = "parent-clk", "sel-clk", "spi-clk";
		mediatek,pad-select = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&stm32_spi_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* Bind spidev through driver_override for this laboratory endpoint. */
		stm32@0 {
			compatible = "st,stm32l452re-test";
			reg = <0>;
			spi-max-frequency = <12000000>;
			spi-cs-setup-delay-ns = <2000>;
			spi-cs-hold-delay-ns = <2000>;
			spi-cs-inactive-delay-ns = <1000>;
		};
	};
};

&pio {
	stm32_spi_pins: stm32-spi-pins {
		pins-bus {
			pinmux = <MT6797_GPIO57__FUNC_SPI0_CLK>,
				 <MT6797_GPIO58__FUNC_SPI0_MI>,
				 <MT6797_GPIO59__FUNC_SPI0_MO>,
				 <MT6797_GPIO60__FUNC_SPI0_CS>;
			input-enable;
			input-schmitt-enable;
			bias-disable;
		};
	};
};
