// SPDX-License-Identifier: GPL-2.0-only
/*
 * Device Tree for the bare X20-96 board.
 *
 * This is intentionally the first, headless bring-up description.  The board
 * has no display or expansion board attached, so only the serial console is
 * enabled until each onboard peripheral is verified separately.
 */

/dts-v1/;

#include <dt-bindings/pinctrl/mt65xx.h>
#include "mt6797.dtsi"

/ {
	model = "X20-96 bare headless";
	compatible = "archermind,x20-96", "mediatek,mt6797";

	aliases {
		serial0 = &uart0;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x80000000>;
	};

	chosen {
		stdout-path = "serial0:921600n8";
		bootargs = "console=ttyS0,921600n8 earlycon=mtk8250,mmio32,0x11002000 root=/dev/ram0 rdinit=/init loglevel=8 printk.time=1";
	};

	reg_vmmc: regulator-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "vmmc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_vqmmc: regulator-vqmmc {
		compatible = "regulator-fixed";
		regulator-name = "vqmmc-1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* FY operating points copied from the vendor MT6797 tables. */
	cluster0_opp: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;
		clock-latency-ns = <30000>;

		opp-1391000000 { opp-hz = /bits/ 64 <1391000000>; opp-microvolt = <1200000>; };
		opp-1339000000 { opp-hz = /bits/ 64 <1339000000>; opp-microvolt = <1180000>; };
		opp-1287000000 { opp-hz = /bits/ 64 <1287000000>; opp-microvolt = <1150000>; };
		opp-1222000000 { opp-hz = /bits/ 64 <1222000000>; opp-microvolt = <1130000>; };
		opp-1118000000 { opp-hz = /bits/ 64 <1118000000>; opp-microvolt = <1090000>; };
		opp-1066000000 { opp-hz = /bits/ 64 <1066000000>; opp-microvolt = <1070000>; };
		opp-949000000 { opp-hz = /bits/ 64 <949000000>; opp-microvolt = <1020000>; };
		opp-897000000 { opp-hz = /bits/ 64 <897000000>; opp-microvolt = <1000000>; };
		opp-806000000 { opp-hz = /bits/ 64 <806000000>; opp-microvolt = <970000>; };
		opp-715000000 { opp-hz = /bits/ 64 <715000000>; opp-microvolt = <940000>; };
		opp-624000000 { opp-hz = /bits/ 64 <624000000>; opp-microvolt = <900000>; };
		opp-559000000 { opp-hz = /bits/ 64 <559000000>; opp-microvolt = <880000>; };
		opp-481000000 { opp-hz = /bits/ 64 <481000000>; opp-microvolt = <850000>; };
		opp-416000000 { opp-hz = /bits/ 64 <416000000>; opp-microvolt = <830000>; };
		opp-338000000 { opp-hz = /bits/ 64 <338000000>; opp-microvolt = <800000>; };
		opp-221000000 { opp-hz = /bits/ 64 <221000000>; opp-microvolt = <780000>; };
	};

	cluster1_opp: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;
		clock-latency-ns = <30000>;

		opp-1846000000 { opp-hz = /bits/ 64 <1846000000>; opp-microvolt = <1200000>; };
		opp-1781000000 { opp-hz = /bits/ 64 <1781000000>; opp-microvolt = <1180000>; };
		opp-1703000000 { opp-hz = /bits/ 64 <1703000000>; opp-microvolt = <1150000>; };
		opp-1625000000 { opp-hz = /bits/ 64 <1625000000>; opp-microvolt = <1130000>; };
		opp-1495000000 { opp-hz = /bits/ 64 <1495000000>; opp-microvolt = <1090000>; };
		opp-1417000000 { opp-hz = /bits/ 64 <1417000000>; opp-microvolt = <1070000>; };
		opp-1274000000 { opp-hz = /bits/ 64 <1274000000>; opp-microvolt = <1020000>; };
		opp-1209000000 { opp-hz = /bits/ 64 <1209000000>; opp-microvolt = <1000000>; };
		opp-1079000000 { opp-hz = /bits/ 64 <1079000000>; opp-microvolt = <970000>; };
		opp-962000000 { opp-hz = /bits/ 64 <962000000>; opp-microvolt = <940000>; };
		opp-832000000 { opp-hz = /bits/ 64 <832000000>; opp-microvolt = <900000>; };
		opp-741000000 { opp-hz = /bits/ 64 <741000000>; opp-microvolt = <880000>; };
		opp-650000000 { opp-hz = /bits/ 64 <650000000>; opp-microvolt = <850000>; };
		opp-559000000 { opp-hz = /bits/ 64 <559000000>; opp-microvolt = <830000>; };
		opp-468000000 { opp-hz = /bits/ 64 <468000000>; opp-microvolt = <800000>; };
		opp-325000000 { opp-hz = /bits/ 64 <325000000>; opp-microvolt = <780000>; };
	};

	cluster2_opp: opp-table-cluster2 {
		compatible = "operating-points-v2";
		opp-shared;
		clock-latency-ns = <30000>;

		opp-2249000000 { opp-hz = /bits/ 64 <2249000000>; opp-microvolt = <1180000>; };
		opp-2197000000 { opp-hz = /bits/ 64 <2197000000>; opp-microvolt = <1170000>; };
		opp-2171000000 { opp-hz = /bits/ 64 <2171000000>; opp-microvolt = <1160000>; };
		opp-2119000000 { opp-hz = /bits/ 64 <2119000000>; opp-microvolt = <1140000>; };
		opp-2093000000 { opp-hz = /bits/ 64 <2093000000>; opp-microvolt = <1130000>; };
		opp-1989000000 { opp-hz = /bits/ 64 <1989000000>; opp-microvolt = <1110000>; };
		opp-1781000000 { opp-hz = /bits/ 64 <1781000000>; opp-microvolt = <1070000>; };
		opp-1677000000 { opp-hz = /bits/ 64 <1677000000>; opp-microvolt = <1050000>; };
		opp-1495000000 { opp-hz = /bits/ 64 <1495000000>; opp-microvolt = <1000000>; };
		opp-1378000000 { opp-hz = /bits/ 64 <1378000000>; opp-microvolt = <980000>; };
		opp-1248000000 { opp-hz = /bits/ 64 <1248000000>; opp-microvolt = <950000>; };
		opp-1131000000 { opp-hz = /bits/ 64 <1131000000>; opp-microvolt = <930000>; };
		opp-1001000000 { opp-hz = /bits/ 64 <1001000000>; opp-microvolt = <900000>; };
		opp-845000000 { opp-hz = /bits/ 64 <845000000>; opp-microvolt = <880000>; };
		opp-676000000 { opp-hz = /bits/ 64 <676000000>; opp-microvolt = <850000>; };
		opp-338000000 { opp-hz = /bits/ 64 <338000000>; opp-microvolt = <800000>; };
	};

	mt6797_cpufreq: cpufreq {
		compatible = "mediatek,mt6797-cpufreq";
		reg = <0 0x1001a000 0 0x1000>,
		      <0 0x10000000 0 0x1000>,
		      <0 0x11015000 0 0x1000>;
		reg-names = "mcumixed", "topckgen", "semaphore";
		status = "okay";
	};
};

&cpu0 { operating-points-v2 = <&cluster0_opp>; cpu-supply = <&vproc1_reg>; };
&cpu1 { operating-points-v2 = <&cluster0_opp>; cpu-supply = <&vproc1_reg>; };
&cpu2 { operating-points-v2 = <&cluster0_opp>; cpu-supply = <&vproc1_reg>; };
&cpu3 { operating-points-v2 = <&cluster0_opp>; cpu-supply = <&vproc1_reg>; };
&cpu4 { operating-points-v2 = <&cluster1_opp>; cpu-supply = <&vproc1_reg>; };
&cpu5 { operating-points-v2 = <&cluster1_opp>; cpu-supply = <&vproc1_reg>; };
&cpu6 { operating-points-v2 = <&cluster1_opp>; cpu-supply = <&vproc1_reg>; };
&cpu7 { operating-points-v2 = <&cluster1_opp>; cpu-supply = <&vproc1_reg>; };
&cpu8 { operating-points-v2 = <&cluster2_opp>; cpu-supply = <&vproc2_reg>; };
&cpu9 { operating-points-v2 = <&cluster2_opp>; cpu-supply = <&vproc2_reg>; };

&uart0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins_a>;
};

/* TOPRGU is the board's hardware reset path, including reboot-to-Fastboot. */
&watchdog {
	status = "okay";
};

/* The board carries the vendor-designated DA9214 VPROC buck at I2C6/0x68. */
&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins_a>;
	clock-frequency = <3400000>;
	mediatek,use-push-pull;
	status = "okay";

	da9214: da9214@68 {
		compatible = "dlg,da9214";
		reg = <0x68>;

		regulators {
			vproc1_reg: BUCKA {
				regulator-name = "vproc1";
				regulator-min-microvolt = <780000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
			};

			vproc2_reg: BUCKB {
				regulator-name = "vproc2";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1180000>;
				regulator-always-on;
			};
		};
	};
};

&mmc0 {
	/* On-board eMMC: begin with the conservative 52 MHz high-speed mode. */
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	non-removable;
	no-sd;
	no-sdio;
	vmmc-supply = <&reg_vmmc>;
	vqmmc-supply = <&reg_vqmmc>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	status = "okay";
};

&pio {
	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
			input-enable;
			input-schmitt-enable;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};

		pins-ds {
			pinmux = <MT6797_GPIO124__FUNC_MSDC0_DSL>;
			input-enable;
			input-schmitt-enable;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};

		pins-rst {
			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <MT6797_GPIO114__FUNC_MSDC0_DAT0>,
				 <MT6797_GPIO115__FUNC_MSDC0_DAT1>,
				 <MT6797_GPIO116__FUNC_MSDC0_DAT2>,
				 <MT6797_GPIO117__FUNC_MSDC0_DAT3>,
				 <MT6797_GPIO118__FUNC_MSDC0_DAT4>,
				 <MT6797_GPIO119__FUNC_MSDC0_DAT5>,
				 <MT6797_GPIO120__FUNC_MSDC0_DAT6>,
				 <MT6797_GPIO121__FUNC_MSDC0_DAT7>,
				 <MT6797_GPIO122__FUNC_MSDC0_CMD>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};

		pins-clk {
			pinmux = <MT6797_GPIO123__FUNC_MSDC0_CLK>;
			input-enable;
			input-schmitt-enable;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};

		pins-ds {
			pinmux = <MT6797_GPIO124__FUNC_MSDC0_DSL>;
			input-enable;
			input-schmitt-enable;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};

		pins-rst {
			pinmux = <MT6797_GPIO125__FUNC_MSDC0_RSTB>;
			input-enable;
			input-schmitt-enable;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			drive-strength = <4>;
			mediatek,tdsel = <0>;
			mediatek,rdsel = <0>;
		};
	};
};
